{
  "name": "xinz-panel-backend-upload",
  "version": "2.6.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "check:node": "node -e \"const m=Number(process.versions.node.split('.')[0]); if(m!==20){console.error('ERROR: Backend ini harus dijalankan dengan Node.js 20. Versi sekarang: '+process.version); process.exit(1)} console.log('OK Node.js '+process.version)\"",
    "start": "npm run check:node && node server.js",
    "start:stable": "npm run check:node && node --expose-gc watchdog.js",
    "health": "npm run check:node && node -e \"fetch(`http://127.0.0.1:${process.env.PORT||3000}/health`).then(r=>r.text()).then(console.log).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "adm-zip": "^0.5.16",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
